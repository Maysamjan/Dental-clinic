# ============================================================
# Dental Clinic Management System — Environment Configuration
# Copy to `.env` and adjust for your deployment.
# ============================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
POSTGRES_DB=dental_clinic
POSTGRES_USER=dental
POSTGRES_PASSWORD=dental_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (Channels / cache) ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MIN=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/ws

# --- Backups ---
BACKUP_DIR=/backups
